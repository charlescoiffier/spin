{
  "name": "spin-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev:server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build:server": "tsc --project server/tsconfig.json --noEmit",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "benchmark": "node --import tsx scripts/benchmark-race.ts",
    "supabase:start": "node --import tsx scripts/supabase-local.ts start",
    "supabase:configure": "node --import tsx scripts/supabase-local.ts configure",
    "supabase:status": "node --import tsx scripts/supabase-local.ts status",
    "supabase:stop": "node --import tsx scripts/supabase-local.ts stop",
    "test:database": "node --import tsx scripts/supabase-local.ts test"
  },
  "dependencies": {
    "@colyseus/core": "0.18.23",
    "@colyseus/sdk": "0.18.9",
    "@colyseus/ws-transport": "0.18.4",
    "@supabase/supabase-js": "2.118.0",
    "express": "5.2.1",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "supabase": "2.122.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
